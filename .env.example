# SEKANI CORE — Environment Configuration
# Generated: 2026-06-05
# See: DISASTER_RECOVERY_SPEC.md for recovery procedures
#
# NEVER commit actual values to source code.
# All secrets must be stored in Replit Secrets or your secure secret manager.

# ─── CRITICAL (Required for startup) ──────────────────────────────────────────

# PostgreSQL connection string (Replit DB or external PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database

# GitHub Personal Access Token — Ostinato-Loop org (source of truth)
GITHUB_PAT=github_pat_xxxx

# n8n MCP Bearer token — raldsekani.app.n8n.cloud
N8N_API_KEY=your_n8n_api_key

# ─── REQUIRED FOR AI (Model Router) ──────────────────────────────────────────

# OpenRouter API key — unified model access (Claude, GPT, Gemini, DeepSeek)
OPENROUTER_API_KEY=sk-or-xxxx

# ─── SUPABASE (Authentication + Realtime) ────────────────────────────────────

SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ─── CLOUDFLARE (Workers, Queues, R2, D1) ────────────────────────────────────

CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# ─── VOICE PIPELINE ──────────────────────────────────────────────────────────

# Deepgram API key — Speech-to-Text for voice pipeline
DEEPGRAM_API_KEY=your_deepgram_api_key

# ─── SERVER ──────────────────────────────────────────────────────────────────

# Port (set automatically by Replit — do not change in production)
PORT=8080

# ─── NOTES ───────────────────────────────────────────────────────────────────
# WIZMAC is the ONLY system allowed to permanently remember things.
# All model calls route through OpenRouter — never call providers directly.
# GitHub (Ostinato-Loop) is the source of truth for all code.
# BBC compliance is required for all AI requests before model execution.
