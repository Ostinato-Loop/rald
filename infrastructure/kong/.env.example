# ============================================================
# RALD Kong Gateway — Environment Variables
# Copy to .env and fill in values. Never commit .env to Git.
# ============================================================

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme-generate-a-strong-password-here
REDIS_PORT=6379
REDIS_MAX_MEMORY=512mb

# ── Kong Ports ────────────────────────────────────────────────────────────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
KONG_ADMIN_PORT=8001
KONG_ADMIN_HTTPS_PORT=8444

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-strong-grafana-password

# ── Environment ───────────────────────────────────────────────────────────────
RALD_ENV=production  # dev | staging | production

# ── Logging endpoint (optional) ───────────────────────────────────────────────
# LOGSTASH_HOST=127.0.0.1
# LOGSTASH_PORT=5044

# ── Alerting (optional) ───────────────────────────────────────────────────────
# PAGERDUTY_KEY=
# SLACK_WEBHOOK_URL=
